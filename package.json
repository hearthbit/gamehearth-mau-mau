{
  "name": "gamehearth-mau-mau",
  "version": "0.5.1",
  "private": true,
  "description": "Mau-Mau for 2–6 players, the first game for Gamehearth",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build --config client/vite.config.ts --logLevel warn",
    "dev:client": "vite --config client/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "check": "gamehearth check .",
    "pack": "npm run build && gamehearth pack ."
  },
  "dependencies": {
    "@gamehearth/sdk": "^0.1.8",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "gamehearth": "^0.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
